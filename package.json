{
  "name": "fossil-design",
  "private": true,
  "description": "Fossil Design: an open-source design system for agentic coding. Tokens in git flow into CSS, typed React components, Figma variables and lint configs that keep generated UI on-system.",
  "license": "MIT",
  "author": "Ibrahim Moazzam (https://github.com/ibrahimmoazzam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimmoazzam/fossil-design.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc && pnpm -r typecheck",
    "test": "vitest run",
    "figma:apply": "pnpm --filter figma-sync apply",
    "figma:read": "pnpm --filter figma-sync read",
    "figma:diff": "pnpm --filter figma-sync diff",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
