{
  "name": "fossil-design",
  "private": true,
  "description": "Fossil Design: an open-source design system for agentic coding. Tokens in git flow into CSS, typed React components, Figma variables and lint configs that keep generated UI on-system.",
  "license": "MIT",
  "author": "Ibrahim Moazzam (https://github.com/ibrahimmoazzam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimmoazzam/fossil-design.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . && stylelint \"**/*.css\" && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc && pnpm -r typecheck",
    "test": "vitest run",
    "check:packages": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-packages.ts",
    "smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "escapes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/escapes.ts",
    "figma:apply": "pnpm --filter figma-sync apply",
    "figma:read": "pnpm --filter figma-sync read",
    "figma:diff": "pnpm --filter figma-sync diff",
    "figma:library-spec": "pnpm --filter figma-sync library-spec",
    "figma:library-check": "pnpm --filter figma-sync library-check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@fossil-design/eslint-config": "workspace:*",
    "@fossil-design/stylelint-config": "workspace:*",
    "@types/node": "^22.20.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "stylelint": "^17.16.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
