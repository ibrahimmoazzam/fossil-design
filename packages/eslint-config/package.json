{
  "name": "@fossil-design/eslint-config",
  "version": "0.0.1",
  "description": "Shared ESLint config that keeps JSX on Fossil's system: layout goes through Box, never raw layout elements.",
  "keywords": [
    "design-system",
    "eslint",
    "eslintconfig",
    "eslint-config"
  ],
  "homepage": "https://github.com/ibrahimmoazzam/fossil-design/tree/main/packages/eslint-config#readme",
  "bugs": "https://github.com/ibrahimmoazzam/fossil-design/issues",
  "license": "MIT",
  "author": "Ibrahim Moazzam (https://github.com/ibrahimmoazzam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimmoazzam/fossil-design.git",
    "directory": "packages/eslint-config"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
