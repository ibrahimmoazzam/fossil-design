{
  "name": "@fossil-design/figma-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Syncs Fossil Design tokens with Figma variables, through an agent and the Figma MCP server. Runs from the repository and is not published.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "apply": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts apply",
    "read": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts read",
    "diff": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts diff",
    "library-spec": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts library-spec",
    "library-check": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts library-check",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "typescript": "catalog:"
  }
}
