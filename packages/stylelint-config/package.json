{
  "name": "@fossil-design/stylelint-config",
  "version": "0.0.2",
  "description": "Shared Stylelint config for Fossil Design: semantic tokens only, no raw values, no margins.",
  "keywords": [
    "design-system",
    "stylelint",
    "stylelint-config",
    "design-tokens"
  ],
  "homepage": "https://github.com/ibrahimmoazzam/fossil-design/tree/main/packages/stylelint-config#readme",
  "bugs": "https://github.com/ibrahimmoazzam/fossil-design/issues",
  "license": "MIT",
  "author": "Ibrahim Moazzam (https://github.com/ibrahimmoazzam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimmoazzam/fossil-design.git",
    "directory": "packages/stylelint-config"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@fossil-design/tokens": "workspace:^",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1"
  },
  "peerDependencies": {
    "stylelint": "^17.0.0"
  },
  "devDependencies": {
    "stylelint": "^17.16.0",
    "typescript": "catalog:"
  }
}
