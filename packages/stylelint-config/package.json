{
  "name": "@fossil-design/stylelint-config",
  "version": "0.0.1",
  "description": "Shared Stylelint config that keeps CSS on Fossil's system: semantic tokens only, no raw values, no margins.",
  "keywords": [
    "design-system",
    "stylelint",
    "stylelint-config",
    "design-tokens"
  ],
  "homepage": "https://github.com/ibrahimmoazzam/fossil/tree/main/packages/stylelint-config#readme",
  "bugs": "https://github.com/ibrahimmoazzam/fossil/issues",
  "license": "MIT",
  "author": "Ibrahim Moazzam (https://github.com/ibrahimmoazzam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimmoazzam/fossil.git",
    "directory": "packages/stylelint-config"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
