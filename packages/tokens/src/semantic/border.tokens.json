{
  "border": {
    "$type": "border",
    "width": {
      "$type": "dimension",
      "default": {
        "$value": "{border.width.1}",
        "$description": "Edges and rules: cards, inputs, tags, table blocks and dividers."
      },
      "hairline": {
        "$value": "{border.width.half}",
        "$description": "The thin frame around images and video: one device pixel on a 2x screen."
      }
    },
    "default": {
      "$value": {
        "color": "{color.border.default}",
        "width": "{border.width.default}",
        "style": "{border.style.solid}"
      },
      "$description": "Container edges: cards, inputs, controls."
    },
    "strong": {
      "$value": {
        "color": "{color.border.strong}",
        "width": "{border.width.default}",
        "style": "{border.style.solid}"
      },
      "$description": "A border that must read as a line: tags, table blocks, dividers."
    },
    "hairline": {
      "$value": {
        "color": "{color.border.default}",
        "width": "{border.width.hairline}",
        "style": "{border.style.solid}"
      },
      "$description": "The thin frame around images and video."
    },
    "focus": {
      "$value": {
        "color": "{color.focus.ring}",
        "width": "{focus.ring.width}",
        "style": "{border.style.solid}"
      },
      "$description": "Focus outlines. Pair with focus.ring.offset."
    }
  },
  "focus": {
    "$type": "dimension",
    "ring": {
      "width": {
        "$value": "{border.width.2}",
        "$description": "The width of the focus indicator, whether a box-shadow ring or border.focus's outline."
      },
      "offset": {
        "$value": "{border.width.2}",
        "$description": "The gap between an element and its focus ring."
      }
    }
  }
}
