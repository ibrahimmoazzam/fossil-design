{
  "color": {
    "$type": "color",
    "background": {
      "transparent": {
        "$value": "{color.transparent}",
        "$description": "No fill: ghost controls and background resets."
      },
      "page": {
        "$value": "{color.white.400}",
        "$description": "The page ground.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.gray.950}"
            }
          }
        }
      },
      "surface": {
        "$value": "{color.white.500}",
        "$description": "Cards, panels, popovers and other surfaces that sit on the page.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.gray.900}"
            }
          }
        }
      },
      "sunken": {
        "$value": "{color.gray.200}",
        "$description": "A fill set below the page, such as a tab track.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.gray.800}"
            }
          }
        }
      },
      "raised": {
        "$value": "{color.white.500}",
        "$description": "A fill that comes back up from a sunken one, such as the selected tab. Never the only sign of selection.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.black.400}"
            }
          }
        }
      },
      "hover": {
        "$value": "{color.alpha.black-400-8}",
        "$description": "The wash behind a hovered row, pill or link.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.alpha.gray-50-8}"
            }
          }
        }
      },
      "wash": {
        "$value": "{color.yellow.100}",
        "$description": "A tint that marks a row without filling it, such as a table header.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.yellow.900}"
            }
          }
        }
      },
      "scrim": {
        "$value": "{color.alpha.black-400-40}",
        "$description": "Behind a modal.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.alpha.black-500-60}"
            }
          }
        }
      },
      "veil": {
        "$value": "{color.alpha.black-500-60}",
        "$description": "A fill over images and video, such as a clip's play button. The same in both modes, because the footage is."
      }
    },
    "text": {
      "default": {
        "$value": "{color.black.400}",
        "$description": "Body text.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.gray.50}"
            },
            "contrast": {
              "against": [
                "{color.background.page}",
                "{color.background.surface}"
              ],
              "minimum": 4.5
            }
          }
        }
      },
      "muted": {
        "$value": "{color.gray.600}",
        "$description": "Secondary text.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.gray.300}"
            },
            "contrast": {
              "against": [
                "{color.background.page}",
                "{color.background.surface}"
              ],
              "minimum": 4.5
            }
          }
        }
      },
      "on-accent": {
        "$value": "{color.white.500}",
        "$description": "Text and icons on an accent fill.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.black.400}"
            },
            "contrast": {
              "against": ["{color.accent.default}"],
              "minimum": 4.5
            }
          }
        }
      },
      "on-highlight": {
        "$value": "{color.white.500}",
        "$description": "Text and icons on a highlight fill.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.black.400}"
            },
            "contrast": {
              "against": ["{color.highlight.default}"],
              "minimum": 4.5
            }
          }
        }
      },
      "on-veil": {
        "$value": "{color.white.500}",
        "$description": "Text and icons on the veil, in both modes.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "contrast": {
              "against": ["{color.background.veil}"],
              "minimum": 4.5
            }
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.200}",
        "$description": "A quiet container edge, meant to sit against a fill. Too faint to stand alone as a line.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.gray.800}"
            }
          }
        }
      },
      "strong": {
        "$value": "{color.gray.500}",
        "$description": "A standalone rule or tick.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "contrast": {
              "against": [
                "{color.background.page}",
                "{color.background.surface}"
              ],
              "minimum": 3
            }
          }
        }
      },
      "hover": {
        "$value": "{color.gray.600}",
        "$description": "A control's edge on hover.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.gray.300}"
            },
            "contrast": {
              "against": [
                "{color.background.page}",
                "{color.background.surface}"
              ],
              "minimum": 3
            }
          }
        }
      },
      "selected": {
        "$value": "{color.highlight.default}",
        "$description": "The edge of the current or selected item.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "contrast": {
              "against": [
                "{color.background.page}",
                "{color.background.surface}"
              ],
              "minimum": 3
            }
          }
        }
      }
    },
    "accent": {
      "default": {
        "$value": "{color.blue.600}",
        "$description": "Links and primary actions.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.blue.400}"
            },
            "contrast": {
              "against": [
                "{color.background.page}",
                "{color.background.surface}"
              ],
              "minimum": 4.5
            }
          }
        }
      }
    },
    "highlight": {
      "default": {
        "$value": "{color.azure.600}",
        "$description": "Small marks that should stand out: the current page, the caret, the selected tab.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.yellow.300}"
            },
            "contrast": {
              "against": [
                "{color.background.page}",
                "{color.background.surface}"
              ],
              "minimum": 4.5
            }
          }
        }
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.highlight.default}",
        "$description": "The focus indicator.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "contrast": {
              "against": [
                "{color.background.page}",
                "{color.background.surface}"
              ],
              "minimum": 3
            }
          }
        }
      }
    },
    "selection": {
      "background": {
        "$value": "{color.azure.100}",
        "$description": "Selected text. The selected text itself takes highlight.default.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.yellow.900}"
            }
          }
        }
      }
    },
    "shadow": {
      "default": {
        "$value": "{color.alpha.black-400-22}",
        "$description": "The colour of every shadow.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "modes": {
              "dark": "{color.alpha.black-500-55}"
            }
          }
        }
      }
    }
  }
}
