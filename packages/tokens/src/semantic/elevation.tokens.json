{
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": {
        "color": "{color.shadow.default}",
        "offsetX": "{base.space.0}",
        "offsetY": "{base.space.025}",
        "blur": "{base.space.100}",
        "spread": "{base.space.0}"
      },
      "$description": "A small lift: tiles and media."
    },
    "floating": {
      "$value": {
        "color": "{color.shadow.default}",
        "offsetX": "{base.space.0}",
        "offsetY": "{base.space.050}",
        "blur": "{base.space.200}",
        "spread": "{base.space.0}"
      },
      "$description": "Floating surfaces: popovers and tooltips."
    },
    "overlay": {
      "$value": {
        "color": "{color.shadow.default}",
        "offsetX": "{base.space.0}",
        "offsetY": "{base.space.300}",
        "blur": "{base.space.600}",
        "spread": "{base.space.0}"
      },
      "$description": "A modal panel over the page."
    }
  },
  "layer": {
    "$type": "number",
    "overlay": {
      "$value": "{base.z-index.100}",
      "$description": "Above page content: popovers, tooltips, the skip link."
    }
  }
}
