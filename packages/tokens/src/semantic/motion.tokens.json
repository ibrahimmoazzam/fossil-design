{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{base.duration.150}",
        "$description": "Colour and border changes."
      },
      "default": {
        "$value": "{base.duration.200}",
        "$description": "Most transitions."
      },
      "slow": {
        "$value": "{base.duration.400}",
        "$description": "Changes in size and layout."
      },
      "base": {
        "$value": "{base.duration.200}",
        "$description": "Most transitions.",
        "$deprecated": "Renamed to motion.duration.default, because base names primitive tokens.",
        "$extensions": {
          "com.ibrahimmoazzam.fossil": {
            "replacedBy": "{motion.duration.default}",
            "since": "0.4.0"
          }
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{base.easing.ease}",
        "$description": "The curve for every transition."
      }
    }
  }
}
