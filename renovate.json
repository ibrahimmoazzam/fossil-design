{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "description": "TypeScript 7 has no JavaScript API yet, which typescript-eslint needs (ADR 0002).",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Node types follow the oldest supported Node (ADR 0002).",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<23"
    }
  ]
}
